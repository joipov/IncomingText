{
  "$schema": "https://raw.githubusercontent.com/LuaLS/lua-language-server/master/locale/en-us/setting.lua",
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "basic": "disable",
    "debug": "disable",
    "io": "disable",
    "math": "disable",
    "os": "disable",
    "package": "disable",
    "string": "disable",
    "table": "disable",
    "utf8": "disable"
  },
  "workspace.library": [
    ".annotations"
  ],
  "workspace.ignoreDir": [
    ".release",
    "assets",
    "tests"
  ],
  "workspace.checkThirdParty": false,
  "diagnostics.globals": [
    "C_AddOns",
    "C_Timer",
    "IncomingTextDB",
    "IncomingText_OnAddonCompartmentClick",
    "IncomingText_OnAddonCompartmentEnter",
    "IncomingText_OnAddonCompartmentLeave",
    "SLASH_INCOMINGTEXT1",
    "SLASH_INCOMINGTEXT2",
    "issecretvalue",
    "canaccessvalue",
    "issecrettable",
    "canaccesstable",
    "C_Spell",
    "C_TooltipInfo",
    "Enum",
    "GetSpellPowerCost",
    "UnitPowerMax",
    "LibStub",
    "bit",
    "CreateFrame",
    "GetTime",
    "GameTooltip",
    "GetCursorPosition",
    "Minimap",
    "UIParent",
    "Settings",
    "ColorPickerFrame",
    "CreateSettingsButtonInitializer",
    "MinimalSliderWithSteppersMixin",
    "print"
  ],
  "diagnostics.severity": {
    "undefined-global": "Error",
    "unused-local": "Error",
    "unused-function": "Error",
    "param-type-mismatch": "Error",
    "missing-return": "Error",
    "need-check-nil": "Error",
    "redundant-parameter": "Error",
    "cast-type-mismatch": "Error"
  }
}
