{
  "$schema": "https://raw.githubusercontent.com/LuaLS/lua-language-server/master/locale/en-us/setting.lua",
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "basic": "disable",
    "debug": "disable",
    "io": "disable",
    "math": "disable",
    "os": "disable",
    "package": "disable",
    "string": "disable",
    "table": "disable",
    "utf8": "disable"
  },
  "workspace.library": [
    ".annotations",
    "C:/Users/rubin/.cursor/extensions/ketho.wow-api/Annotations/Core"
  ],
  "workspace.ignoreDir": [
    ".release",
    "assets",
    "tests"
  ],
  "workspace.checkThirdParty": false,
  "diagnostics.globals": [
    "C_AddOns",
    "C_Spell",
    "C_Timer",
    "CombatTextDB",
    "CombatText_OnAddonCompartmentClick",
    "CombatText_OnAddonCompartmentEnter",
    "CombatText_OnAddonCompartmentLeave",
    "SLASH_CT1",
    "SLASH_CT2",
    "issecretvalue",
    "canaccessvalue",
    "LibStub",
    "bit",
    "CreateFrame",
    "GetTime",
    "UnitIsUnit",
    "GetInventoryItemTexture",
    "Enum",
    "GameTooltip",
    "GetCursorPosition",
    "Minimap",
    "UIParent",
    "Settings",
    "ColorPickerFrame",
    "CreateSettingsButtonInitializer",
    "MinimalSliderWithSteppersMixin",
    "print"
  ],
  "diagnostics.severity": {
    "undefined-global": "Error",
    "unused-local": "Error",
    "unused-function": "Error",
    "param-type-mismatch": "Error",
    "missing-return": "Error",
    "need-check-nil": "Error",
    "redundant-parameter": "Error",
    "cast-type-mismatch": "Error"
  }
}
